# Public — safe for browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL — used for absolute links, OG meta, and canonical URLs.
# In production set to your actual domain, e.g. https://cuchoami.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: newer Supabase "publishable" key (alias of anon for browser use).
# Leave empty unless your project issues a publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only admin client — NEVER prefix with NEXT_PUBLIC_
# Used only in lib/supabase/admin-client.ts and scripts/create-admin-user.mjs
SUPABASE_SERVICE_ROLE_KEY=server_only_never_prefix_with_next_public

# Admin bootstrap — used only by scripts/create-admin-user.mjs, not by the app
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# Layout debug overlay — set to true to enable SectionGuide outlines and
# the LayoutGridOverlay column grid. Disabled by default.
NEXT_PUBLIC_LAYOUT_DEBUG=false

# Analytics — server-only salt for IP hashing. NEVER prefix with NEXT_PUBLIC_.
# Generate a value with: openssl rand -hex 32
ANALYTICS_SALT=replace_with_long_random_secret_min_32_chars

# Google Analytics 4 measurement id (public). Leave empty to disable GA entirely.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4 Measurement Protocol API secret (SERVER-ONLY — never prefix with NEXT_PUBLIC_).
# Used to send server-confirmed ecommerce events (purchase/refund) that must not be
# missed or duplicated. Create in: GA Admin → Data Streams → (your stream) →
# Measurement Protocol API secrets → Create. Leave empty to disable server-side
# GA events (client-side events still work).
GA4_API_SECRET=

# Bank reconciliation webhook (server-only). Used to validate incoming
# bank transaction webhooks. NEVER expose client-side / NEXT_PUBLIC_.


# SePay payment provider (server-only). Free tier: 50 auto-confirms/month.
# Webhook URL: https://<your-domain>/api/payments/sepay-webhook
# Authentication: HMAC-SHA256 — SePay signs raw body with this secret.
# Signature header sent by SePay: x-SePay-Signature
# Secret format from SePay dashboard: whsec_...
# Payment-code filter in SePay: DH
# NEVER prefix with NEXT_PUBLIC_ — this is a server-only HMAC secret.
SEPAY_ENABLED=false
SEPAY_WEBHOOK_SECRET=whsec_replace_with_real_sepay_hmac_secret
SEPAY_MONTHLY_FREE_QUOTA=50
SEPAY_PROVIDER_NAME=sepay

# Payment code (server-only). All new codes: DH + 8 uppercase alphanumeric chars (e.g. DH8A2K9QZ1).
# Must match SePay Live config: prefix DH, suffix 3–10 chars, letters+digits only.
# NEVER prefix with NEXT_PUBLIC_ — generated server-side only.
PAYMENT_CODE_PREFIX=DH
PAYMENT_CODE_SUFFIX_LENGTH=8

# VietQR dynamic image fallback (server-only).
# Used when site_settings does not have bank info configured.
# Priority: site_settings (Admin → Settings) → these env vars → hardcoded test values.
# BANK_QR_BANK_ID must be the VietQR BIN/code (e.g. 970403 for Sacombank, 970436 for Vietcombank).
# Only the 11 SePay-supported banks in lib/payments/banks.ts are valid (see docs/backend/admin-bank-settings.md).
# Do NOT use the display name (e.g. "Sacombank") — it won't match a VietQR bank.
# NEVER prefix with NEXT_PUBLIC_ — URL is generated server-side and sent as data.
BANK_QR_BANK_ID=
BANK_QR_ACCOUNT_NO=
BANK_QR_ACCOUNT_NAME=
BANK_QR_TEMPLATE=compact2

# ── Auth: password reset email (Resend) ────────────────────────────────────
# Server-only. Get an API key at https://resend.com (free tier available) and
# verify a sending domain/address. RESEND_FROM_EMAIL must be a verified sender.
# Used by app/api/auth/forgot-password to email the 5-minute reset link.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cúc Họa Mi <no-reply@your-domain.com>

# ── Auth: reCAPTCHA v2 (checkbox) — anti-bot on register + forgot-password ──
# Create keys at https://www.google.com/recaptcha/admin (type: reCAPTCHA v2
# "I'm not a robot"). If left empty the widget is hidden and the server check
# is skipped (local dev). SECRET is server-only; SITE_KEY is public.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Google OAuth ───────────────────────────────────────────────────────────
# No env keys needed here — enable the Google provider in the Supabase
# Dashboard (Authentication → Providers → Google) with your Google Cloud OAuth
# client id/secret, and add <site>/auth/callback to the allowed redirect URLs.

# Shipping fee, free-shipping discounts, and timezone are configured in Admin → Settings
# (site_settings groups: shipping, time). See docs/backend/shipping-settings.md,
# docs/backend/timezone-settings.md. Default timezone: Asia/Ho_Chi_Minh (UTC+7).
